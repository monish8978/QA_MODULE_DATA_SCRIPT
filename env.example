# ───────── OPERATIONAL MODE ─────────
# Supported modes: 'db' (MySQL), 'dir' (Directory scanning), 'api' (External API poll)
PROCESS_MODE=dir

# ───────── MYSQL DATABASE CONFIGURATION (db mode) ─────────
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=sqladmin
DB_NAME=czentrix_campaign_manager
DB_PORT=3306



# ───────── EXTERNAL API CONFIGURATION (api mode) ─────────
SOURCE_API_URL=http://example.com/api/get-recordings
SOURCE_API_METHOD=GET
SOURCE_API_HEADERS={"Content-Type": "application/json"}
SOURCE_API_BODY={}


# ───────── TRANSCRIPTION SERVICE CONFIGURATION ─────────
TRANSCRIPTION_ENABLED=true
TRANSCRIPTION_API_URL=https://call_transcript.c-zentrix.com/api/v1/transcribe
TRANSCRIPTION_STATUS_URL=https://call_transcript.c-zentrix.com/api/v1/status
TRANSCRIPTION_API_KEY=VFItcm9vdEB0dnQjMTIz
# TRANSCRIPTION_SUBMISSION_METHOD sets how audio is sent to the transcription API.
# Options:
#   'url'    - Sends a JSON payload with {"file_url": "..."} or {"file_path": "..."}
#   'upload' - Streams and uploads the physical file via multipart/form-data
TRANSCRIPTION_SUBMISSION_METHOD=upload

# ───────── QA MODULE API CONFIGURATION ─────────
QA_API_BASE_URL=https://api-dev.tvtworld.com/api/v1
QA_TENANT_SLUG=testing
QA_EMAIL=testing@c-zentrix.com
QA_PASSWORD=Password@123

# ───────── MEDIA AND SERVER CONFIGURATION ─────────
RECORDING_BASE_URL=http://192.168.1.219
QA_TOPIC=connectivity
QA_SOURCE=app_mqji9bzivusp

# ───────── CELERY & REDIS CONFIGURATION ─────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

POLL_INTERVAL_SECONDS=60
SCAN_BACK_DAYS=0

# ───────── MULTI-TENANT CONFIGURATION (Optional) ─────────
# Comma-separated list of tenant identifier keys
# TENANTS=aman,monish,test
#
# # Tenant 1: Aman
# QA_TENANT_SLUG_aman=aman-kumar
# QA_EMAIL_aman=aman.yadav@c-zentrix.com
# QA_PASSWORD_aman=Password@123
# SCAN_DIRECTORY_PATH_aman=/var/spool/asterisk/monitor_0/aman/
# QA_SOURCE_aman=app_aman_source
#
